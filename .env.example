# Clave de TMDB: solo la usa el servidor (proxy de Vite en local, función /api/tmdb en Vercel).
# No lleva el prefijo VITE_, así que nunca se incluye en el JavaScript del navegador.
TMDB_API_KEY=your_api_key_here

# Opcional: URL base de las imágenes (son públicas, no necesitan key).
VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/original
